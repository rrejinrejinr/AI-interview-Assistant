# =============================================================================
# AI Interview Assistant — Backend Environment Configuration Template
# =============================================================================

# --- Email / SMTP Settings ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
SUPPORT_RECEIVER_EMAIL=support@example.com

# --- LLM Provider Selection ---
# Options: 'groq' (default), 'grok' (xAI), 'gemini', 'openai', or leave blank for local fallback
LLM_PROVIDER=groq

# --- 1. Groq Configuration (Primary — Fast LPU Inference) ---
# Obtain from Groq Console: https://console.groq.com/keys
# Key format: starts with 'gsk_'
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional custom base URL (default: https://api.groq.com/openai/v1)
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- 2. xAI Grok Configuration (Alternative) ---
# Obtain from xAI Console: https://console.x.ai/
# XAI_API_KEY=xai-your_xai_api_key_here
# XAI_MODEL=grok-2-latest
# XAI_BASE_URL=https://api.x.ai/v1

# --- 3. Google Gemini Configuration (Alternative / Secondary Fallback) ---
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
# GEMINI_MODEL=gemini-1.5-flash

# --- 4. OpenAI / OpenRouter Configuration (Alternative / Tertiary Fallback) ---
# OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
