# =============================================================================
# AI Interview Assistant - Environment Configuration Template
# =============================================================================
# Copy this file to .env and populate with your production values.
# NEVER commit the actual .env file or credentials to version control.

# Application Environment
APP_ENV=development                # development | staging | production
APP_PORT=8001
DEBUG=True                         # Set to False in production

# Security & Authentication
JWT_SECRET_KEY=replace_with_a_secure_random_32_character_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database Configuration
# PostgreSQL (Production): postgresql://user:password@localhost:5432/interview_db
# SQLite (Development fallback): sqlite:///./app.db
DATABASE_URL=sqlite:///./app.db

# CORS Configuration (Comma-separated list of allowed frontend origins)
# In production, set to your exact domain e.g. https://ai-interview-assistant.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Email / SMTP Configuration (for candidate OTP verification)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@ai-assistant.local

# LLM Provider Configuration (Optional - falls back to deterministic engine if empty)
# Providers: openai | gemini | openrouter | custom | mock
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# ATS Scoring Weights (Must sum to 1.0)
ATS_SEMANTIC_WEIGHT=0.50
ATS_SKILL_WEIGHT=0.50

# Interview Scoring Weights (Must sum to 1.0)
INTERVIEW_SEMANTIC_WEIGHT=0.65
INTERVIEW_KEYWORD_WEIGHT=0.35

# Face Presence Monitoring Settings (Seconds)
FACE_WARNING_SECONDS=5
FACE_ABSENCE_LIMIT_SECONDS=15

# Upload Constraints
MAX_UPLOAD_SIZE_MB=5
